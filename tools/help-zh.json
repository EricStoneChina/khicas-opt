{
  "factor":     { "howto": "因式分解多项式(整数分解用 ifactor)。用法:factor(p) 或 factor(p,x)", "ex1": "factor(x^4-1)", "ex2": "factor(x^6+1,sqrt(3))" },
  "expand":     { "howto": "展开表达式:去括号、合并同类项。用法:expand(expr)", "ex1": "expand((x+1)^3)", "ex2": "expand((x+y+z)^2)" },
  "simplify":   { "howto": "化简表达式。用法:simplify(expr)", "ex1": "simplify(sin(3x)/sin(x))", "ex2": "simplify((x^2-1)/(x-1))" },
  "integrate":  { "howto": "求积分。用法:integrate(f,x) 求不定积分;integrate(f,x,a,b) 求定积分", "ex1": "integrate(x*sin(x),x)", "ex2": "integrate(1/(1+x^2),x,0,1)" },
  "diff":       { "howto": "求导数。用法:diff(f,x) 一阶导数;diff(f,x,n) n 阶导数", "ex1": "diff(sin(x),x)", "ex2": "diff(x^3,x,2)" },
  "solve":      { "howto": "解方程(精确解)。用法:solve(方程,x);方程组:solve([eq1,eq2],[x,y])", "ex1": "solve(x^2-3x+2=0,x)", "ex2": "solve([x+y=3,x-y=1],[x,y])" },
  "limit":      { "howto": "求极限。用法:limit(f,x=a);单侧极限:limit(f,x=a,1) 右极限、limit(f,x=a,-1) 左极限", "ex1": "limit(sin(x)/x,x=0)", "ex2": "limit(abs(x)/x,x=0,1)" },
  "series":     { "howto": "幂级数展开。用法:series(f,x=a,n) 在 x=a 处展开到 n 阶", "ex1": "series(sin(x),x=0,5)", "ex2": "series(exp(x),x=0,4)" },
  "taylor":     { "howto": "泰勒展开。用法:taylor(f,x=a,n);加 polynom 参数可去掉余项", "ex1": "taylor(sin(x),x=0,5)", "ex2": "taylor(sin(x),x=0,5,polynom)" },
  "sum":        { "howto": "求和。用法:sum(f,k,m,M) 表示 k 从 m 到 M 对 f 求和", "ex1": "sum(k^2,k,1,10)", "ex2": "sum(1/k^2,k,1,inf)" },
  "product":    { "howto": "求积。用法:product(f,k,m,M) 表示 k 从 m 到 M 对 f 求积", "ex1": "product(k,k,1,5)", "ex2": "product((k+1)/k,k,1,10)" },
  "seq":        { "howto": "生成列表。用法:seq(f,k,a,b) 或 seq(f,k,a,b,步长)", "ex1": "seq(j^2,j,1,5)", "ex2": "seq(j^2,j,1,10,2)" },
  "subst":      { "howto": "代入替换:把 a 中的 b 换成 c。用法:subst(a,b=c),也可简写 a(b=c)", "ex1": "subst(x^2+1,x=3)", "ex2": "sin(x)(x=pi/2)" },
  "normal":     { "howto": "化简有理式(通分、合并)。用法:normal(expr)", "ex1": "normal(1/x+1/(x+1))", "ex2": "normal((x^2-1)/(x-1))" },
  "quo":        { "howto": "多项式整除的商。用法:quo(p,q,x);整数的商用 iquo(a,b)", "ex1": "quo(x^3-1,x-1,x)", "ex2": "iquo(23,13)" },
  "rem":        { "howto": "多项式整除的余数。用法:rem(p,q,x);整数的余数用 irem(a,b)", "ex1": "rem(x^3-1,x-1,x)", "ex2": "irem(23,13)" },
  "iquo":       { "howto": "整数整除的商。用法:iquo(a,b)", "ex1": "iquo(23,13)", "ex2": "iquo(-23,13)" },
  "irem":       { "howto": "整数整除的余数。用法:irem(a,b)", "ex1": "irem(23,13)", "ex2": "irem(-23,13)" },
  "egcd":       { "howto": "扩展欧几里得算法:求 U,V,D 使 A*U+B*V=D=gcd(A,B)。用法:egcd(A,B)", "ex1": "egcd(x^2+3x+1,x^2-5x-1)", "ex2": "egcd(23,13)" },
  "euler":      { "howto": "欧拉函数 φ(n):小于 n 且与 n 互素的整数个数。用法:euler(n)", "ex1": "euler(25)", "ex2": "euler(100)" },
  "rootof":     { "howto": "多项式的根(符号形式)。用法:rootof(P)", "ex1": "rootof(x^2-2)", "ex2": "rootof(x^3-1)" },
  "partfrac":   { "howto": "部分分式分解。用法:partfrac(p,x)", "ex1": "partfrac(1/(x^4-1),x)", "ex2": "partfrac((x^2+1)/(x-1),x)" },
  "rank":       { "howto": "矩阵的秩。用法:rank(A)", "ex1": "rank([[1,2],[2,4]])", "ex2": "rank([[1,2,3],[4,5,6]])" },
  "idn":        { "howto": "n 阶单位矩阵。用法:idn(n)", "ex1": "idn(3)", "ex2": "idn(3)*[[1,2,3],[4,5,6],[7,8,9]]" },
  "size":       { "howto": "求列表/矩阵的维数(矩阵返回 [行数,列数])。用法:size(L)", "ex1": "size([1,2,3])", "ex2": "size([[1,2],[3,4]])" },
  "mean":       { "howto": "算术平均值。用法:mean(L)", "ex1": "mean([3/2,2,1,1/2,3,2,3/2])", "ex2": "mean([1,2,3,4,5])" },
  "stddev":     { "howto": "标准差。用法:stddev(L)", "ex1": "stddev([1,2,3,4,5])", "ex2": "stddev([3/2,2,1,1/2,3,2,3/2])" },
  "variance":   { "howto": "方差。用法:variance(L)", "ex1": "variance([1,2,3,4,5])", "ex2": "variance([3/2,2,1,1/2,3,2,3/2])" },
  "median":     { "howto": "中位数。用法:median(L)", "ex1": "median([3/2,2,1,1/2,3,2,3/2])", "ex2": "median([1,2,3,4])" },
  "isprime":    { "howto": "判断整数是否为素数:是返回 1,否则返回 0。用法:isprime(n)", "ex1": "isprime(1999)", "ex2": "isprime(2^61-1)" },
  "ifactor":    { "howto": "整数质因数分解。用法:ifactor(n)", "ex1": "ifactor(1234)", "ex2": "ifactor(2^32+1)" },
  "nextprime":  { "howto": "返回大于 n 的下一个素数。用法:nextprime(n)", "ex1": "nextprime(100)", "ex2": "nextprime(1000)" },
  "prevprime":  { "howto": "返回小于 n 的前一个素数。用法:prevprime(n)", "ex1": "prevprime(100)", "ex2": "prevprime(1000)" },
  "gcd":        { "howto": "最大公因数 / 多项式最大公因式。用法:gcd(a,b,...)", "ex1": "gcd(23,13)", "ex2": "gcd(x^2-1,x^3-1)" },
  "lcm":        { "howto": "最小公倍数。用法:lcm(a,b,...)", "ex1": "lcm(23,13)", "ex2": "lcm(x^2-1,x^3-1)" },
  "det":        { "howto": "方阵的行列式。用法:det(A)", "ex1": "det([[1,2],[3,4]])", "ex2": "det([[1,2,3],[4,5,6],[7,8,10]])" },
  "inv":        { "howto": "矩阵求逆(或表达式的倒数)。用法:inv(A)", "ex1": "inv([[1,2],[3,4]])", "ex2": "inv(2)" },
  "transpose":  { "howto": "矩阵转置(共轭转置用 trn(A))。用法:transpose(A)", "ex1": "transpose([[1,2],[3,4]])", "ex2": "transpose([[1,2,3]])" },
  "plot":       { "howto": "绘制函数图像。用法:plot(f) 或 plot(f,x=a..b)", "ex1": "plot(sin(x))", "ex2": "plot(ln(x),x=0.5..5)" },
  "randmatrix": { "howto": "生成随机矩阵。用法:randmatrix(m,n) 生成 m×n 随机整数矩阵", "ex1": "randmatrix(3,3)", "ex2": "randmatrix(2,4)" },
  "sort":       { "howto": "排序(升序)。用法:sort(L)", "ex1": "sort([3,1,2])", "ex2": "sort([\"b\",\"a\",\"c\"])" },
  "round":      { "howto": "四舍五入。用法:round(x),或 round(x,n) 保留 n 位小数", "ex1": "round(2.567)", "ex2": "round(2.567,2)" },
  "floor":      { "howto": "向下取整(不超过 x 的最大整数)。用法:floor(x)", "ex1": "floor(pi)", "ex2": "floor(-2.7)" },
  "ceil":       { "howto": "向上取整(不小于 x 的最小整数)。用法:ceil(x)", "ex1": "ceil(1.2)", "ex2": "ceil(-2.7)" },
  "abs":        { "howto": "绝对值 / 复数的模 / 向量范数。用法:abs(x)", "ex1": "abs(-3)", "ex2": "abs(3+4i)" },
  "sqrt":       { "howto": "平方根。用法:sqrt(x)", "ex1": "sqrt(16)", "ex2": "sqrt(2)" },
  "ln":         { "howto": "自然对数。用法:ln(x)", "ex1": "ln(e)", "ex2": "ln(10)" },
  "exp":        { "howto": "指数函数 e^x。用法:exp(x)", "ex1": "exp(1)", "ex2": "exp(i*pi)" },
  "min":        { "howto": "最小值。用法:min(a,b,...) 或 min(L)", "ex1": "min(3,1,2)", "ex2": "min([3,1,2])" },
  "max":        { "howto": "最大值。用法:max(a,b,...) 或 max(L)", "ex1": "max(3,1,2)", "ex2": "max([3,1,2])" },
  "reverse":    { "howto": "反转列表或字符串。用法:reverse(L)", "ex1": "reverse([1,2,3])", "ex2": "reverse(\"abc\")" }
}
