        "0",
        "+infinity"
      ],
      "expected": "1/2"
    },
    {
      "id": "C7-tail-mellin-11",
      "f": "x*ln(1+x^2)^2/(1+x^2)^2",
      "bounds": [
        "0",
        "+infinity"
      ],
      "expected": "1"
    },
    {
      "id": "C7-tail-mellin-12",
      "f": "ln(1+x)/(1+x)^2",
      "bounds": [
        "0",
        "+infinity"
      ],
      "expected": "1"
    },
    {
      "id": "C7-tail-mellin-13",
      "f": "ln(2+2*x)/(2+2*x)^2",
