// ============================================================================
// KhiCAS 优化基准脚本(在计算器/KhiCAS 中运行)
//
// 用法:
//   在 KhiCAS 中逐行粘贴,或:
//     read("bench/bench.xws")
// 结果会显示每项耗时(秒),末尾输出对比表。
//
// 一致性检查:所有结果应与 -Os 基线逐位一致。
// ============================================================================
// 计算内核基准(速度敏感)
t0 := time(factor(2^127-1));                     // 大整数因数分解
t1 := time(isprime(2^521-1));                    // 梅森素数判定(521 位)
t2 := time(factor(x^50-1));                      // 多项式分解
t3 := time(integrate(ln(x)^5,x));                // 符号积分
t4 := time(inv(randmatrix(30,30)));              // 30×30 矩阵求逆
t5 := time(ifactors(1000!));                     // 1000! 大数素因子分解
t6 := time(series(sin(x),x=0,20));               // 泰勒级数展开
t7 := time(solve(x^5-x-1,x));                    // 高次方程求解
t8 := time(gcd(x^100-1,x^60-1));                 // 多项式最大公约式
t9 := time(expand((x+y+z)^20));                  // 符号展开

// 内存压力基准(评估 prizm_heap)
t10 := time(normal(randmatrix(50,50)*randmatrix(50,50)));  // 50×50 矩阵乘法

// 结果表
[["factor(2^127-1)", t0],
 ["isprime(2^521-1)", t1],
 ["factor(x^50-1)", t2],
 ["integrate(ln(x)^5,x)", t3],
 ["inv(randmatrix(30,30))", t4],
 ["ifactors(1000!)", t5],
 ["series(sin(x),x=0,20)", t6],
 ["solve(x^5-x-1,x)", t7],
 ["gcd(x^100-1,x^60-1)", t8],
 ["expand((x+y+z)^20)", t9],
 ["50x50 matmul", t10]]

"全部完成"
